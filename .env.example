# football-data.org の無料APIキー（試合日程の取得に使用）
# 取得: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# Amazonアソシエイト トラッキングID（審査通過後に設定）
NEXT_PUBLIC_AMAZON_TAG=

# 楽天（もしもアフィリエイト経由）。管理画面の「どこでもリンク」で作ったURLをそのまま入れる。
# url= パラメータの中身だけを差し替えて使うので、どのページ向けに作ったものでもよい。
NEXT_PUBLIC_AFFILIATE_MOSHIMO_RAKUTEN=

# 楽天アフィリエイト直のID（もしも経由を使う場合は不要）
NEXT_PUBLIC_RAKUTEN_AFFILIATE_ID=

# Google Search Console の所有権確認コード（metaタグ方式の content 値のみ）
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# お問い合わせ先（どちらか一方。フォームURLのほうがメールアドレスを公開せずに済む）
NEXT_PUBLIC_CONTACT_FORM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Google AdSense のパブリッシャーID（審査通過後に設定）
NEXT_PUBLIC_ADSENSE_CLIENT=
