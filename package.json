{
  "name": "kaigaigumi-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "export:output": "node scripts/copy-to-output.mjs",
    "assets:icons": "node scripts/make-icons.mjs",
    "assets:og-font": "python scripts/make-og-font.py",
    "assets:font": "python scripts/make-font.py",
    "check:highlights": "node scripts/check-highlights.mjs",
    "data:wikipedia": "node scripts/fetch-wikipedia.mjs",
    "data:fixtures": "node scripts/fetch-fixtures.mjs",
    "data:competitions": "node scripts/check-competitions.mjs",
    "data:videos": "node scripts/verify-videos.mjs",
    "data:transfers": "node scripts/detect-transfers.mjs",
    "data:alumni": "node scripts/fetch-alumni.mjs",
    "data:highlights": "node scripts/fetch-highlights.mjs",
    "data:standings": "node scripts/fetch-standings.mjs",
    "data:season": "node scripts/fetch-season-stats.mjs && node scripts/generate-season-stats.mjs",
    "data:check": "node scripts/check-players.mjs",
    "data:candidates": "node scripts/fetch-candidates.mjs --report",
    "data:players": "node scripts/fetch-candidates.mjs && node scripts/fetch-players.mjs scripts/player-candidates.json && node scripts/generate-players.mjs && node scripts/fetch-clubs.mjs",
    "data:clubs": "node scripts/fetch-clubs.mjs",
    "data:loans": "node scripts/check-loans.mjs"
  },
  "dependencies": {
    "next": "^15.5.23",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3"
  }
}
